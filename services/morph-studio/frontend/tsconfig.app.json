{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": { "@/*": ["./src/*"] },
    // `Array.prototype.at` and friends. Every browser this tool runs in has
    // them; the default lib is conservative for libraries shipped to the world,
    // which an internal editorial UI is not.
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  }
}

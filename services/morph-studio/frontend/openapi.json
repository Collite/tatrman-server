    "/v1/machine": {
      "get": {
        "summary": "Machine",
        "description": "The LM-14 status machine, so the UI does not keep its own copy.\n\nSame reasoning as `/v1/vzory`, applied to states instead of patterns:\na frontend holding its own list draws chips for states that do not\nexist and offers a Verify button on an edge the machine refuses, and\nthe reviewer finds out by getting a 409. Served, the buttons *are* the\nmachine — a state added to `status.py` reaches them with no frontend\nrelease, and an invented one cannot appear.",
        "operationId": "machine_v1_machine_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MachineResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/vzory": {
      "get": {
        "summary": "Vzory",
        "description": "The closed inventory the UI's pattern picker is built from.\n\nServed rather than hard-coded in the frontend for the reason the\ninventory is data in the first place (LM-2): a sub-vzor added to\n`vzory.yaml` has to reach the picker without a frontend release, or the\nanalyst who needs it cannot choose it.",
        "operationId": "vzory_v1_vzory_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VzoryResponse"
                }
              }
            }
          }
        }
      }
    },

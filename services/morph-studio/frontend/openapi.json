  "components": {
    "schemas": {
      "CascadeModel": {
        "properties": {
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/ProposalModel-Output"
            },
            "type": "array",
            "title": "Proposals"
          },
          "tier": {
            "type": "string",
            "title": "Tier",
            "default": "human"
          },
          "agreed": {
            "type": "boolean",
            "title": "Agreed",
            "default": false
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "proposals",
          "tier",
          "agreed",
          "notes"
        ],
        "title": "CascadeModel",
        "description": "What the cascade concluded about a queue item."
      },
      "CorrectForms": {
        "properties": {
          "forms": {
            "items": {
              "$ref": "#/components/schemas/FormModel-Input"
            },
            "type": "array",
            "title": "Forms"
          },
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "human"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "forms"
        ],
        "title": "CorrectForms",
        "description": "`POST /entries/{id}/forms` — the edited table (FI-7 surface 2).\n\nSending a corrected table converts the entry to a full-form one at export:\nthe pattern no longer describes it, and pretending otherwise is\n`LM-MORPH-005`."
      },
      "EntryModel": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "lemma": {
            "type": "string",
            "title": "Lemma"
          },
          "upos": {
            "type": "string",
            "title": "Upos"
          },
          "layer": {
            "type": "string",
            "title": "Layer"
          },
          "vzor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vzor"
          },
          "flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Flags"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "provenance": {
            "type": "string",
            "title": "Provenance"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          },
          "provisional": {
            "type": "boolean",
            "title": "Provisional"
          },
          "forms": {
            "items": {
              "$ref": "#/components/schemas/FormModel-Output"
            },
            "type": "array",
            "title": "Forms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "lemma",
          "upos",
          "layer",
          "vzor",
          "flags",
          "status",
          "provenance",
          "source",
          "confidence",
          "provisional",
          "forms"
        ],
        "title": "EntryModel"
      },
      "ExportRequest": {
        "properties": {
          "write": {
            "type": "boolean",
            "title": "Write",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExportRequest"
      },
      "ExportResponse": {
        "properties": {
          "files": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Files"
          },
          "written": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Written"
          },
          "exported": {
            "type": "integer",
            "title": "Exported",
            "default": 0
          },
          "withheld": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Withheld"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "files",
          "written",
          "exported",
          "withheld"
        ],
        "title": "ExportResponse"
      },
      "FormModel-Input": {
        "properties": {
          "form": {
            "type": "string",
            "title": "Form"
          },
          "feats": {
            "type": "string",
            "title": "Feats",
            "default": ""
          },
          "corrected": {
            "type": "boolean",
            "title": "Corrected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "form"
        ],
        "title": "FormModel"
      },
      "FormModel-Output": {
        "properties": {
          "form": {
            "type": "string",
            "title": "Form"
          },
          "feats": {
            "type": "string",
            "title": "Feats",
            "default": ""
          },
          "corrected": {
            "type": "boolean",
            "title": "Corrected",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "form",
          "feats",
          "corrected"
        ],
        "title": "FormModel"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestRequest": {
        "properties": {
          "reports": {
            "items": {
              "$ref": "#/components/schemas/Report"
            },
            "type": "array",
            "title": "Reports"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reports"
        ],
        "title": "IngestRequest"
      },
      "IngestResponse": {
        "properties": {
          "accepted": {
            "type": "integer",
            "title": "Accepted",
            "default": 0
          },
          "created": {
            "type": "integer",
            "title": "Created",
            "default": 0
          },
          "updated": {
            "type": "integer",
            "title": "Updated",
            "default": 0
          },
          "rejected": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Rejected"
          },
          "overlay_emitted": {
            "type": "boolean",
            "title": "Overlay Emitted",
            "default": false
          },
          "reload": {
            "type": "string",
            "title": "Reload",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accepted",
          "created",
          "updated",
          "rejected",
          "overlay_emitted",
          "reload"
        ],
        "title": "IngestResponse"
      },
      "LookupResponse": {
        "properties": {
